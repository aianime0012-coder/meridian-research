# Meridian OS — Credentials Environment Template

> Copy to the runner as `.env` / environment variables or store each value in a
> secret vault (n8n credentials, Azure Key Vault, Bitwarden). NEVER commit
> real values to git. Values below are placeholder examples only.

## Workflow engine
N8N_ENCRYPTION_KEY=replace-with-strong-random-key

## Database (canonical records + kpi_log)
DB_TYPE=postgres            # or sqlite (local bootstrap)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meridian
DB_USER=meridian_app
DB_PASSWORD=replace-me
# SQLite alternative (bootstrap/dev only)
# SQLITE_PATH=D:\\meridian\\meridian.db

## Payments
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
PAYPAL_CLIENT_ID=replace-me
PAYPAL_CLIENT_SECRET=replace-me

## CRM / enrichment
HUBSPOT_API_KEY=replace-me
AIRTABLE_API_KEY=replace-me
CRUNCHBASE_API_KEY=replace-me
CLEARBIT_API_KEY=replace-me
HUNTER_API_KEY=replace-me
APOLLO_API_KEY=replace-me
